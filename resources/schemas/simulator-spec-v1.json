{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudsoft.local/schemas/simulator-spec-v1.json",
  "title": "Lesson Simulator Spec",
  "type": "object",
  "required": ["meta", "sections"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["topic_key", "title", "languages", "level"],
      "additionalProperties": false,
      "properties": {
        "topic_key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "level": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hero",
            "concept_cards",
            "code_tabs",
            "interactive",
            "reference_table",
            "comparison",
            "checklist",
            "mini_quiz",
            "callout"
          ]
        },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" },
        "variant": { "type": "string", "enum": ["info", "warning", "tip", "danger"] },
        "items": { "type": "array" },
        "snippets": { "type": "array" },
        "widget": { "type": "string" },
        "config": { "type": "object" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array" },
        "questions": { "type": "array" },
        "pairs": { "type": "array" }
      }
    }
  }
}

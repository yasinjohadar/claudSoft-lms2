    "/api/v1/Create_Campaign": {
      "post": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Create a campaign from a template",
        "description": "Note the unusual `Create_Campaign` PascalCase + underscore path — preserved\nfor backwards compatibility. Most parameters are passed as **query string**;\nany template body/header variables go in the **JSON body** as `body` and\n`header` maps (positional, keyed by 1-based index — the keys are strings).\n\nIf the template has no variables, send an empty JSON body (`{}`).\n",
        "operationId": "createCampaign",
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenQuery"
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Campaign name (free text).",
            "schema": {
              "type": "string"
            },
            "example": "May Promo"
          },
          {
            "name": "template_id",
            "in": "query",
            "required": true,
            "description": "Template id (from `/getTemplates`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Defaults to `api`.",
            "schema": {
              "type": "string",
              "enum": [
                "api",
                "regular",
                "bot"
              ],
              "default": "api"
            }
          },
          {
            "name": "group_id",
            "in": "query",
            "required": true,
            "description": "Target group id (from `/getGroups`).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Variable substitution map. Skip entirely if the template has no variables.",
                "properties": {
                  "header": {
                    "type": "object",
                    "description": "Header variables, keyed by 1-based string index.\n`{\"1\": \"Welcome Daniel\"}` substitutes `{{1}}` in the template header.\n",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "example": {
                      "1": "Welcome Daniel"
                    }
                  },
                  "body": {
                    "type": "object",
                    "description": "Body variables, keyed by 1-based string index.\n`{\"1\": \"Daniel\", \"2\": \"Sat 14 May\"}` substitutes `{{1}}` and `{{2}}` in the body.\n",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "example": {
                      "1": "Daniel",
                      "2": "Sat 14 May"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "campaign": {
                      "$ref": "#/components/schemas/Campaign"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/sendcampaigns": {
      "post": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Trigger sending of a created campaign",
        "description": "Dispatches a previously-created campaign to its target group.\n**Field naming**: this endpoint uses `campaing_id` (missing the second `g`) —\na historical typo preserved for backwards compatibility.\n",
        "operationId": "sendCampaigns",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "campaing_id",
                  "group_id"
                ],
                "properties": {
                  "token": {
                    "$ref": "#/components/schemas/Token"
                  },
                  "campaing_id": {
                    "type": "integer",
                    "description": "Campaign id (yes, the field name has a typo — see endpoint description).",
                    "example": 301
                  },
                  "group_id": {
                    "type": "string",
                    "description": "Target group id.",
                    "example": "102"
                  },
                  "data": {
                    "type": "object",
                    "description": "Optional override map; leave as `{}` to use the campaign's stored variables.",
                    "example": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign send dispatched.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "campaign_id": {
                      "type": "integer"
                    },
                    "queued_count": {
                      "type": "integer",
                      "description": "Number of recipients queued."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,audit
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_EXTERNAL_DRIVER=papertrail
# LOG_EXTERNAL_LEVEL=error
# LOG_EXTERNAL_PATH=storage/logs/external.log
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOG_RETENTION_DAYS=365

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set to false only if the server lacks CA certificates (e.g. minimal Docker image)
MAIL_SMTP_VERIFY_PEER=true
MAIL_SMTP_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Parallel AI stack: legacy (default) | laravel_ai
AI_APPLICATION_ENGINE=legacy
# Blog wizard: omit = auto (use Laravel AI SDK if any active laravel_ai_models row exists)
# AI_BLOG_ENGINE=legacy
# AI_BLOG_ENGINE=laravel_ai
# Documentation AI create page: same semantics as AI_BLOG_ENGINE
# AI_DOCS_ENGINE=legacy
# AI_DOCS_ENGINE=laravel_ai
# Admin question generation (same semantics as AI_BLOG_ENGINE)
# AI_QUESTIONS_ENGINE=legacy
# AI_QUESTIONS_ENGINE=laravel_ai
# Lesson simulator AI wizard (same semantics as AI_BLOG_ENGINE)
# AI_SIMULATORS_ENGINE=legacy
# AI_SIMULATORS_ENGINE=laravel_ai
# Admin student progress AI reports (same semantics as AI_BLOG_ENGINE)
# AI_REPORTS_ENGINE=legacy
# AI_REPORTS_ENGINE=laravel_ai

# Laravel AI SDK / Prism (Guzzle): cURL error 60 on Windows — save cacert.pem as:
#   storage/cacert.pem  (see https://curl.se/ca/cacert.pem — no .env needed)
# Or set a custom path:
# AI_HTTP_VERIFY="C:\php\extras\ssl\cacert.pem"
# Local debugging only (insecure — never production):
# AI_HTTP_VERIFY=false

# Optional global ceiling for laravel_ai_models max completion tokens (omit = no extra cap)
# AI_COMPLETION_TOKENS_CEILING=32000

# WPForms Webhook Configuration
WPFORMS_WEBHOOK_SECRET=

# n8n Integration Configuration
N8N_WEBHOOK_SECRET=
N8N_DEFAULT_TIMEOUT=30
N8N_DEFAULT_RETRY_ATTEMPTS=3
N8N_VERIFY_SSL=true
N8N_QUEUE_NAME=webhooks

# Flaxxa WhatsApp WAPI (Send API — token from provider dashboard)
WHATSAPP_TOKEN=
WHATSAPP_WAPI_BASE_URL=https://wapi.flaxxa.com/api/v1
# WHATSAPP_WAPI_TIMEOUT=60
# WHATSAPP_MAX_ATTACHMENT_KB=5120
# WHATSAPP_WAPI_RATE_LIMIT=30

# Notification hub — Flaxxa WAPI channel for automated template notifications
NOTIFY_CHANNEL_WHATSAPP_WAPI=true

# Phone OTP via Flaxxa WAPI (configure template in admin: settings/phone-otp)
# Admin panel is the primary toggle; set to false only as an emergency kill-switch.
PHONE_OTP_ENABLED=true
# PHONE_OTP_TTL_SECONDS=300
# PHONE_OTP_CODE_LENGTH=6
# PHONE_OTP_RATE_LIMIT_PHONE=3
# PHONE_OTP_RATE_LIMIT_WINDOW=15

# Wasender API (Custom API provider + MCP)
WASENDER_BASE_URL=https://www.wasenderapi.com/api
WASENDER_API_KEY=
WASENDER_MCP_URL=https://wasenderapi.com/mcp
WASENDER_MCP_PERSONAL_ACCESS_TOKEN=

# Programming challenges — Piston code execution
PISTON_URL=http://127.0.0.1:2000
PISTON_TIMEOUT=10
PISTON_VERSION=*

# Local dev quick login (APP_ENV=local only — also enable in Admin → Site Settings)
# LOCAL_DEV_LOGIN_PATH=_dev/platform-access
# LOCAL_DEV_ADMIN_EMAIL=admin@admin.com
# LOCAL_DEV_STUDENT_EMAIL=student@gmail.com

# Browsershot — PDF export for documentation pages (requires Node.js + Chromium on server)
# After composer install, run: npm install (includes puppeteer for local PDF export)
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/usr/bin/npm
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
# BROWSERSHOT_NO_SANDBOX=true
# BROWSERSHOT_TIMEOUT=120
# BROWSERSHOT_PDF_BROWSER_DELAY_MS=2000
# BROWSERSHOT_PDF_SIGNED_URL_TTL=5
# BROWSERSHOT_PDF_INTERNAL_URL=http://127.0.0.1:8000
# BROWSERSHOT_PDF_BROWSER_USE_SIGNED_URL=false
# DOCS_PDF_ORG_NAME="أكاديمية كلاودسوفت"
# DOCS_PDF_TAGLINE="تعليم البرمجة وتطوير البرمجيات"

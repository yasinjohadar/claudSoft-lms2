# .htaccess for Production Server
# ضع هذا الملف في المجلد الرئيسي للمشروع

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow access to storage (for uploaded files)
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    RewriteCond %{REQUEST_URI} ^/public/storage/
    RewriteRule ^ - [L]
    
    # Prevent access to sensitive files and directories
    RewriteCond %{REQUEST_URI} !^/storage/
    RewriteCond %{REQUEST_URI} !^/public/storage/
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|\.git|\.gitignore|\.gitattributes|README\.md|DEPLOYMENT\.md|deploy\.sh) - [F,L]
    
    # Redirect all requests to public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /public/$1 [L]
    
    # If accessing root directly, redirect to public
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^(.*)$ /public/ [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Prevent access to .htaccess files
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Prevent access to sensitive files
<FilesMatch "^(\.env|\.env\.backup|\.gitignore|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|README\.md|DEPLOYMENT\.md|deploy\.sh)$">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

